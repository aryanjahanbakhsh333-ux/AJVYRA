from dataclasses import dataclass, field
from typing import Dict, List


@dataclass
class RPGCharacter:
    name: str
    hp: int
    attack: int
    defense: int
    level: int = 1
    xp: int = 0
    gold: int = 25


@dataclass
class StoryRPG:
    title: str = "Echoes of Asteria"
    chapter: int = 1
    location: str = "Asteria Village"
    player: RPGCharacter = field(
        default_factory=lambda: RPGCharacter(
            name="Kael",
            hp=100,
            attack=18,
            defense=10
        )
    )
    inventory: List[str] = field(
        default_factory=lambda: ["Wooden Sword", "Healing Herb"]
    )
    flags: Dict[str, bool] = field(default_factory=dict)

    def start(self):
        return {
            "title": self.title,
            "chapter": self.chapter,
            "location": self.location,
            "character": self.player.name,
            "objective": "Find the missing crystal shard."
        }

    def attack_enemy(self, enemy_hp: int, enemy_defense: int):
        damage = max(1, self.player.attack - enemy_defense)
        enemy_hp -= damage
        return damage, enemy_hp

    def take_damage(self, amount: int):
        damage = max(1, amount - self.player.defense)
        self.player.hp = max(0, self.player.hp - damage)
        return damage

    def gain_xp(self, amount: int):
        self.player.xp += amount

        required = self.player.level * 100

        if self.player.xp >= required:
            self.player.xp -= required
            self.player.level += 1
            self.player.attack += 4
            self.player.defense += 2
            self.player.hp += 15
            return True

        return False

    def choose(self, option: str):
        if option == "forest":
            self.location = "Whispering Forest"
            self.flags["entered_forest"] = True
            return "The forest path opens."

        if option == "village":
            self.location = "Asteria Village"
            return "You return to the village."

        if option == "ruins":
            self.location = "Ancient Ruins"
            self.flags["found_ruins"] = True
            return "Ancient ruins emerge from the mist."

        return "Unknown choice."

    def use_herb(self):
        if "Healing Herb" not in self.inventory:
            return False

        self.inventory.remove("Healing Herb")
        self.player.hp = min(100 + self.player.level * 15,
                             self.player.hp + 30)
        return True

    def defeat_boss(self):
        if self.location != "Ancient Ruins":
            return False

        self.flags["boss_defeated"] = True
        self.chapter += 1
        self.gain_xp(150)
        self.inventory.append("Crystal Shard")
        return True


GAME = StoryRPG()
